{
  "$comment": "Production: pin the account id, multi-AZ NAT, reader instance, deletion protection, compliance-mode audit lock.",
  "account": "000000000000",
  "region": "us-east-1",
  "vpc_cidr": "10.42.0.0/16",
  "max_azs": 3,
  "nat_gateways": 3,
  "db_min_acu": 1,
  "db_max_acu": 32,
  "db_reader": true,
  "db_backup_days": 30,
  "db_removal": "snapshot",
  "deletion_protection": true,
  "raw_retention_days": 30,
  "log_retention_days": 365,
  "audit_object_lock_mode": "compliance",
  "audit_object_lock_days": 2555,
  "api_provisioned_concurrency": 2,
  "api_throttle_rate": 200,
  "api_throttle_burst": 400,
  "waf_rate_limit_per_5min": 2000,
  "beacon_rate_limit_per_5min": 600,
  "cognito_domain_prefix": "leadintel-prod-changeme",
  "callback_urls": ["https://leads.example.com/auth/callback"],
  "beacon_allowed_origins": ["https://www.example.com"],
  "alarm_email": "oncall@example.com",
  "monthly_budget_usd": 2500,
  "scrapebadger_run_credit_budget": 2000,
  "ai_enabled": true,
  "account_guardrails": true,
  "domain_name": null,
  "certificate_arn": null,
  "github_repository": "boomerang-karma/math-star-academy",
  "discovery_schedule": "cron(0 2 * * ? *)",
  "discovery_tasks": [
    {"connector": "scrapebadger", "playbook": "market_hiring_scan",
     "params": {"keywords": ["revenue operations", "sales development"], "location": "United States",
                "date_posted": "past_24h"}, "credit_budget": 400},
    {"connector": "scrapebadger", "playbook": "market_hiring_scan",
     "params": {"keywords": ["revenue operations"], "location": "United Kingdom", "date_posted": "past_24h"},
     "credit_budget": 200}
  ]
}
