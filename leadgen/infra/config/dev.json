{
  "$comment": "Development: smallest footprint, auto-pausing database, everything destroyable.",
  "account": null,
  "region": "us-east-1",
  "vpc_cidr": "10.40.0.0/16",
  "max_azs": 2,
  "nat_gateways": 1,
  "db_min_acu": 0,
  "db_max_acu": 4,
  "db_reader": false,
  "db_backup_days": 1,
  "db_removal": "destroy",
  "deletion_protection": false,
  "raw_retention_days": 14,
  "log_retention_days": 14,
  "audit_object_lock_mode": "governance",
  "audit_object_lock_days": 1,
  "api_provisioned_concurrency": 0,
  "api_throttle_rate": 50,
  "api_throttle_burst": 100,
  "waf_rate_limit_per_5min": 2000,
  "beacon_rate_limit_per_5min": 600,
  "cognito_domain_prefix": "leadintel-dev-changeme",
  "callback_urls": ["http://localhost:5173/auth/callback"],
  "beacon_allowed_origins": ["http://localhost:4173"],
  "alarm_email": null,
  "monthly_budget_usd": 300,
  "scrapebadger_run_credit_budget": 500,
  "ai_enabled": false,
  "account_guardrails": false,
  "github_repository": null,
  "discovery_schedule": "cron(0 2 ? * MON-FRI *)",
  "discovery_tasks": [
    {"connector": "scrapebadger", "playbook": "market_hiring_scan",
     "params": {"keywords": ["revenue operations"], "location": "United States"}, "credit_budget": 100}
  ]
}
